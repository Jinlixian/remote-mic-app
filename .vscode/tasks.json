{
  // All local SwiftPM invocations keep --disable-keychain (AGENTS.md).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SayAll: Build Debug",
      "type": "process",
      "command": "xcrun",
      "args": [
        "swift",
        "build",
        "-c",
        "debug",
        "--disable-keychain",
        "--product",
        "RemoteMic"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SAYALL_ENABLE_PRIVATE_SWIFTPM": "",
          "SAYALL_PRIVATE_PLATFORM_PACKAGE_PATH": "",
          "SAYALL_PRIVATE_ARTIFACT_PACKAGE_PATH": "",
          "SAYALL_MAC_REMOTE_PACKAGE_PATH": "",
          "SAYALL_SIRI_REMOTE_PACKAGE_PATH": "",
          "SAYALL_CHROMECAST_PACKAGE_PATH": "",
          "SAYALL_AI_PACKAGE_PATH": "",
          "SAYALL_COMBINATION_ACTIONS_PATH": "",
          "SAYALL_BUTTON_PROFILES_PACKAGE_PATH": "",
          "SAYALL_ENABLE_SIRI_REMOTE": "",
          "SAYALL_ENABLE_CHROMECAST": "",
          "SAYALL_ENABLE_BUTTON_PROFILES": ""
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      // Any running SayAll instance holds the flock-based single-instance lock
      // (Library/Application Support/RemoteMic/.app-instance.lock) and makes a
      // freshly launched debug process exit immediately. Match every bundle
      // location (installed apps, dist/SayAll.app, custom paths), plus any PID
      // that actually holds the lock file, then wait for them to terminate.
      "label": "SayAll: Quit Running Instances",
      "type": "shell",
      "command": "lock=\"$HOME/Library/Application Support/RemoteMic/.app-instance.lock\"; list_pids() { pgrep -f '/Contents/MacOS/RemoteMic$' 2>/dev/null; [ -f \"$lock\" ] && /usr/sbin/lsof -t \"$lock\" 2>/dev/null; return 0; }; list_pids | sort -u | while read -r pid; do [ -n \"$pid\" ] && kill -TERM \"$pid\" 2>/dev/null; done; for attempt in $(seq 1 30); do [ -z \"$(list_pids | sort -u)\" ] && break; sleep 0.2; done; remaining=\"$(list_pids | sort -u)\"; if [ -n \"$remaining\" ]; then echo \"A SayAll instance is still running; quit it before debugging.\" >&2; pgrep -af '/Contents/MacOS/RemoteMic$' >&2; exit 1; fi; echo 'SayAll running instances stopped (if any)'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "SayAll: Prepare Debug",
      "dependsOn": [
        "SayAll: Quit Running Instances",
        "SayAll: Build Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // Rebuilds the full, locally runnable SayAll.app bundle using the repo's
      // public packaging path (ad-hoc signed, no private dependencies). Used as
      // the preLaunchTask for debugging the packaged Mac app in launch.json.
      "label": "SayAll: Build Mac App",
      "type": "shell",
      "command": "SAYALL_PRIVATE_PLATFORM_MODE=public CONFIGURATION=release REQUIRE_DEVELOPER_ID_SIGNING=0 ./scripts/build-app.sh >/dev/null && app_bin=\"$PWD/dist/SayAll.app/Contents/MacOS/RemoteMic\" && app_uuid=\"$(xcrun dwarfdump --uuid \"$app_bin\" | awk '/arm64/{print $2; exit}')\" && [ -n \"$app_uuid\" ] || { echo 'Cannot read app binary UUID' >&2; exit 1; }; dsym=\"\"; while IFS= read -r candidate; do [ -d \"$candidate\" ] || continue; if xcrun dwarfdump --uuid \"$candidate\" 2>/dev/null | grep -qi \"$app_uuid\"; then dsym=\"$candidate\"; break; fi; done < <(find /private/tmp/remote-mic-swiftpm \"$PWD/.build\" -name 'RemoteMic.dSYM' 2>/dev/null); if [ -z \"$dsym\" ]; then echo 'No matching RemoteMic.dSYM found; source breakpoints will be unavailable' >&2; else rm -rf \"$PWD/.build/SayAll.app.dSYM\" && mkdir -p \"$PWD/.build\" && cp -R \"$dsym\" \"$PWD/.build/SayAll.app.dSYM\" && echo \"Staged dSYM ($app_uuid) at .build/SayAll.app.dSYM\"; fi; echo \"Build ok: dist/SayAll.app\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/bash"
        },
        "env": {
          "SAYALL_ENABLE_PRIVATE_SWIFTPM": "",
          "SAYALL_PRIVATE_PLATFORM_PACKAGE_PATH": "",
          "SAYALL_PRIVATE_ARTIFACT_PACKAGE_PATH": "",
          "SAYALL_MAC_REMOTE_PACKAGE_PATH": "",
          "SAYALL_SIRI_REMOTE_PACKAGE_PATH": "",
          "SAYALL_CHROMECAST_PACKAGE_PATH": "",
          "SAYALL_AI_PACKAGE_PATH": "",
          "SAYALL_COMBINATION_ACTIONS_PATH": "",
          "SAYALL_BUTTON_PROFILES_PACKAGE_PATH": "",
          "SAYALL_BUILD_CHANNEL": "",
          "SAYALL_PRIVATE_SOURCE_ROOT": "",
          "SAYALL_PRIVATE_ARTIFACTS_SOURCE": "",
          "REMOTE_MIC_SENTRY_DSN": "",
          "SAYALL_DIAGNOSTIC_PUBLIC_KEY_BASE64": "",
          "CODE_SIGN_IDENTITY": ""
        }
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "SayAll: Prepare Mac App Debug",
      "dependsOn": [
        "SayAll: Quit Running Instances",
        "SayAll: Build Mac App"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "SayAll: Run Tests",
      "type": "process",
      "command": "xcrun",
      "args": [
        "swift",
        "test",
        "--disable-keychain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "SayAll: Self Test",
      "type": "process",
      "command": "./scripts/test.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
